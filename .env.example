# Copy to .env and fill in. A blank value means "not set".
# Keep comments on their own lines: `docker run --env-file` does not strip a
# trailing "# comment" and would make it part of the value.

# --- Discord (required) ---
# Bot token (Developer Portal > Bot)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# Server ID. Slash commands are registered on this server.
DISCORD_GUILD_ID=
# Text channel in which the ticket threads are created
DISCORD_TICKETS_CHANNEL_ID=
# Optional: members of this role are added to every open ticket thread
DISCORD_TICKET_ROLE_ID=

# --- Zammad (required) ---
# URL the bot uses for the API (an internal Docker/Kubernetes address is fine)
ZAMMAD_BASE_URL=http://zammad-nginx:8080
# Optional: URL used in links shown to people (defaults to ZAMMAD_BASE_URL)
ZAMMAD_PUBLIC_URL=https://support.example.com
# API token with the admin and ticket.agent permissions
ZAMMAD_API_TOKEN=
# Same value as the webhook's "HMAC SHA1 Signature Token" in Zammad.
# Use a long random string, e.g. `openssl rand -hex 32`.
ZAMMAD_WEBHOOK_SECRET=

# --- Access control ---
# Comma-separated Discord user IDs allowed to run /setup. Blank = nobody.
ADMIN_USER_IDS=

# --- Server ---
PORT=3100
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Optional: enables the /debug/* routes, which then require
# "Authorization: Bearer <DEBUG_TOKEN>". Blank = the routes do not exist.
DEBUG_TOKEN=

# --- AI commands (optional: /aireply, /aisummary, /aihelp, ...) ---
# Can also be set at runtime with /setup ai (stored in data/bot.db, wins over these).
AI_API_KEY=
# openrouter | openai | anthropic
AI_PROVIDER=openrouter
# Optional: provider default when blank
AI_MODEL=
# Optional: custom OpenAI-compatible endpoint
AI_BASE_URL=
# Optional fallback, used when the primary provider fails
AI_FALLBACK_API_KEY=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# --- Web search for /aihelp (optional) ---
SEARCH_API_KEY=
# tavily | brave
SEARCH_PROVIDER=tavily
SEARCH_FALLBACK_API_KEY=
SEARCH_FALLBACK_PROVIDER=

# --- Daily summary (optional) ---
# Hour of day (0-23, bot timezone) to post ticket statistics. Blank = off.
DAILY_SUMMARY_HOUR=
